# Copy to .env and adjust as needed. These defaults match docker-compose.yml
# and are meant for LOCAL DEVELOPMENT ONLY -- change every credential below
# before running anything resembling production.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=asyncflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=asyncflow

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HTTP_PORT=15672

# AsyncFlow behavior
MAX_TASK_RETRIES=5
RETRY_BACKOFF_BASE_SECONDS=2.0
RETRY_BACKOFF_MAX_SECONDS=60.0
WORKER_CONCURRENCY=5
GRACEFULLY_SHUTDOWN_TIMEOUT_SECONDS=30
